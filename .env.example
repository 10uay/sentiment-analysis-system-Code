APP_NAME=Sentiment Analysis System
APP_ENV=dev
API_PREFIX=/api/v1
SECRET_KEY=change-me
ACCESS_TOKEN_EXPIRE_MINUTES=1440

DATABASE_URL=sqlite:///./sentiment.db
REDIS_URL=redis://localhost:6379/0

ENABLE_HF_MODELS=false
ARABERT_MODEL_NAME=aubmindlab/bert-base-arabertv02
XLMR_MODEL_NAME=cardiffnlp/twitter-xlm-roberta-base-sentiment

ENABLE_LLM=false
LLM_PROVIDER=mock
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

ENABLE_RAG=true
VECTOR_INDEX_PATH=./vector_index.json
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
